# =============================================================================
# App
# =============================================================================
IELTS_GOAL=IELTS Listening Band 7+
# Canonical site origin for SEO (sitemap, Open Graph). No trailing slash.
SITE_URL=http://localhost:3000


# =============================================================================
# Database
# =============================================================================
# Active database connection.
MONGODB_URI=mongodb://127.0.0.1:27017/english_for_only_me
# Alternative - Local
# MONGODB_URI=mongodb://127.0.0.1:27017/english_for_only_me


# =============================================================================
# External APIs - YouTube
# =============================================================================
# Optional. When empty, YouTube imports are saved as URL-only drafts.
YOUTUBE_API_KEY=


# =============================================================================
# AI - Qwen (Alibaba Cloud Model Studio)
# =============================================================================
# Optional. When DASHSCOPE_API_KEY is empty, AI features (dictation debrief,
# segment translation, IELTS generation, writing grading, listening TTS)
# return an unavailable state; IELTS tests can still be written by hand.
# Listening TTS also needs CLOUDINARY_URL to store the audio.
DASHSCOPE_API_KEY=
# Optional: workspace API host, default https://dashscope-intl.aliyuncs.com
DASHSCOPE_HOST=
# Optional model overrides, defaults live in src/constants/environments.ts
QWEN_DEBRIEF_MODEL=
QWEN_TRANSLATION_MODEL=
QWEN_IELTS_GENERATION_MODEL=
QWEN_IELTS_GRADING_MODEL=
QWEN_TTS_MODEL=

# Successful writing gradings per learner per UTC day.
IELTS_WRITING_DAILY_LIMIT=10


# =============================================================================
# Storage - Cloudinary
# =============================================================================
# Used by admin topic thumbnail uploads. Keep this server-only.
CLOUDINARY_URL=


# =============================================================================
# Auth & Secrets (server-only)
# =============================================================================
# Google authentication (Auth.js v5)
# Authorized redirect URI: <origin>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: openssl rand -base64 33   (or: npx auth secret)
AUTH_SECRET=
# Comma-separated Google emails granted the admin role.
ADMIN_EMAILS=
# Lets scripts (seed, backfill) expire the shared content cache through
# POST /api/admin/revalidate. Generate with: openssl rand -base64 33
REVALIDATE_SECRET=
